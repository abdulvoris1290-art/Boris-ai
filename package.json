{
  "name": "voris-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Voris AI — a premium AI assistant platform",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/setup.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
