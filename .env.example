# ─────────────────────────────────────────────────────────────
#  Voris AI — server configuration
#  Copy to `.env` and fill in. Keys here never reach the browser.
# ─────────────────────────────────────────────────────────────

# Server port (the Vite dev server proxies /api to this port)
PORT=3001

# Public origin(s) allowed to make state-changing requests (comma separated).
# Leave empty in local dev. In production set e.g. https://voris.example.com
APP_ORIGIN=

# Voris AI is a private assistant: the first account created becomes the owner and
# sign-up then closes. Set to true to let more people create accounts.
ALLOW_SIGNUP=false

# Behind Cloudflare or a hosting load balancer, set how many proxy hops to trust
# (usually 1) so rate limits see each visitor's real IP. Leave empty otherwise.
TRUST_PROXY=

# ── AI provider ──────────────────────────────────────────────
# One of: groq | anthropic | openai | openrouter | custom
# Easiest: run `npm run setup` and it fills this in for you.
AI_PROVIDER=groq
AI_API_KEY=
# Optional overrides (sensible defaults are chosen per provider)
AI_MODEL=
# Model used when a message contains images (defaults to AI_MODEL)
AI_VISION_MODEL=
# Only for AI_PROVIDER=custom — any OpenAI-compatible endpoint (e.g. Ollama, vLLM, Together)
AI_BASE_URL=
# Anthropic only: low | medium | high | xhigh | max (leave empty for the model default)
AI_EFFORT=

# ── Web search (optional) ────────────────────────────────────
# One of: tavily | brave   (Tavily has a free tier: https://app.tavily.com)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ── Storage ──────────────────────────────────────────────────
# SQLite database file (created automatically)
DATABASE_PATH=./data/voris.db
